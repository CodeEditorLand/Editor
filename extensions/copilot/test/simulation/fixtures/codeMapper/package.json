	"bugs": {
		"url": "https://github.com/Microsoft/vscode/issues"
	},
	"devDependencies": {
		"@microsoft/tiktokenizer": "^1.0.10",
		"@types/node": "^26.1.2",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@types/vscode": "^1.125.0",
		"esbuild": "0.28.1",
		"mocha": "^11.7.6",
		"npm-dts": "^1.3.13",
		"prettier": "^3.9.6",
		"tsx": "^4.23.4",
		"typescript": "^7.0.2"
	}
}